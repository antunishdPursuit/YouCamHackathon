{
  "name": "yincol",
  "private": true,
  "version": "0.1.0",
  "description": "YINCOL — one selfie, two garments, one makeup look, one coordinated decision.",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:web": "npm run dev --workspace @yincol/web",
    "dev:server": "npm run dev --workspace @yincol/server",
    "build": "npm run build --workspace @yincol/web",
    "test": "npm run test --workspace @yincol/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "capture-fixtures": "npm run capture-fixtures --workspace @yincol/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3"
  }
}
