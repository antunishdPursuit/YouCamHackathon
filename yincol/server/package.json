{
  "name": "@yincol/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Express proxy. Exists only to hide the API key and normalise the async pipeline.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "make-placeholders": "tsx scripts/make-placeholders.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@yincol/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
