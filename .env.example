# ─────────────────────────────────────────────────────────────
# YINCOL environment template. Copy to `.env` and fill in.
# `.env` is gitignored. Never commit a real key.
# ─────────────────────────────────────────────────────────────

# Fixture mode is the default and needs no credentials at all.
# The app runs end to end with zero network access and zero API credits.
# Keep this true until the Facial Color Tone integration is verified.
# Enable the verified live image features with the two flags below. The palette
# remains an explicitly labelled example; image results come from uploaded files.
YINCOL_FIXTURE_MODE=true

# Optional Skin Analysis-only live increment. Set this to true while leaving
# fixture mode on to send the browser portrait through the verified File API
# without enabling the still-unverified live palette flow.
YINCOL_LIVE_SKIN_ANALYSIS=false

# Optional Clothes/Makeup VTO-only live increment. Set this to true while leaving
# fixture mode on to send browser-held portrait and garment files through the verified
# feature File APIs. The palette remains fixture-backed until Facial Color Tone is verified.
YINCOL_LIVE_TRY_ON=false

# Perfect Corp S2S API key. v2.0 endpoints take it directly as
# `Authorization: Bearer <key>` — there is no RSA / client_secret
# exchange on v2.0. Leave empty in fixture mode.
#
# THIS KEY IS THE SWITCH. The server fails closed on it: with no key there is no live
# path, whatever the three flags above say, and a mistyped flag cannot spend a credit.
# The demo deployment omits the key. Live generation needs it only on the API server;
# never set it on the static site or in a VITE_ variable. Requested live generation
# without a key makes the health check unavailable instead of silently serving a demo.
YINCOL_API_KEY=

# API host. UNVERIFIED: both hosts appear in Perfect Corp materials.
# Default is the makeupar host; swap here if the Playground says otherwise.
YINCOL_API_BASE_URL=https://yce-api-01.makeupar.com

# Force one of the designed states, for showing them without waiting for one to
# happen. Fixture mode only — live mode ignores this.
#   none                 normal flow (default)
#   noFace               the photograph has no readable face
#   partialFailure       garment B's garment task fails, so both of its panels fail;
#                        garment A is untouched
#   completeLookFailure  garment B's garment task succeeds and its makeup step does not,
#                        so it keeps a usable garment preview
#   skinUnavailable      skin appearance context is missing; the palette is unaffected
YINCOL_SIMULATE=none

# Express port for the API service. Render supplies PORT in production. The separate
# static site has no runtime port. See docs/deployment.md.
PORT=8787

# Exact browser origin allowed to call the API service. Leave empty for local development
# and the Vite same-origin proxy. Do not use a wildcard.
YINCOL_ALLOWED_ORIGIN=

# Set to true ONLY when the app sits behind a proxy that terminates TLS. It makes
# `req.ip` read the forwarded header, which is the rate limiter's key — trusting that
# header when nothing sets it would let any caller choose their own limit bucket.
YINCOL_TRUST_PROXY=false

# Static-site build setting for the split deployment. Set this in the static site's
# environment, not on the API service. Use the API origin only, without `/api`.
# VITE_API_URL=https://<api-service>.onrender.com
